{
  "name": "jev-othello",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "fmt": "oxfmt --write src package.json tsconfig.json .oxlintrc.json .oxfmtrc.json README.md",
    "fmt:check": "oxfmt --check src package.json tsconfig.json .oxlintrc.json .oxfmtrc.json README.md",
    "lint": "oxlint --deny-warnings src",
    "lint:fix": "oxlint --deny-warnings src --fix"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002"
  }
}
