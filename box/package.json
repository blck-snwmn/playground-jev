{
  "name": "jev-box",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env --hot src/server.ts",
    "build": "bun --no-env-file build --target=bun --production --outdir=dist ./src/server.ts",
    "start": "bun --cwd dist --env-file=../.env server.js",
    "test": "bun --no-env-file test",
    "lint": "oxlint --deny-warnings src",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@playground-jev/common": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004"
  }
}
