{
  "name": "jev-tetris",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env --hot src/server.ts",
    "start": "bun --env-file=.env src/server.ts",
    "test": "bun test",
    "fmt": "oxfmt --write src package.json tsconfig.json .oxlintrc.json .oxfmtrc.json README.md",
    "fmt:check": "oxfmt --check src package.json tsconfig.json .oxlintrc.json .oxfmtrc.json README.md",
    "lint": "oxlint --deny-warnings src",
    "lint:fix": "oxlint --deny-warnings src --fix"
  },
  "dependencies": {
    "@playground-jev/common": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004"
  }
}
