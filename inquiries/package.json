{
  "name": "jev-inquiries",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env --hot src/server.ts",
    "build": "bun --no-env-file build --target=bun --production --outdir=dist ./src/server.ts",
    "start": "bun --cwd dist --env-file=../.env server.js",
    "test": "bun --no-env-file test",
    "lint": "oxlint --deny-warnings src",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002"
  }
}
